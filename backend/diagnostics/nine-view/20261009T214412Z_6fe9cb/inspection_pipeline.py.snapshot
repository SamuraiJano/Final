"""Hot per-fruit strategy assignment around the existing detector and tracker."""
from collections import Counter, deque
from dataclasses import asdict, replace
from types import SimpleNamespace
from uuid import uuid4
import time

import numpy as np

from algorithm import NaartjiePipeline, MappingError, _as_numpy
from nine_view import NineViewEngine, progress_at


class ObservedDetector:
    def __init__(self, model, owner):
        self.model, self.owner = model, owner

    def __getattr__(self, name):
        return getattr(self.model, name)

    def track(self, *args, **kwargs):
        result = self.model.track(*args, **kwargs)
        boxes = result[0].boxes
        self.owner.neighbours = _as_numpy(boxes.xyxy) if boxes is not None else []
        return result


class InspectionPipeline:
    inspection_router = True

    def __init__(self, surface, configuration_provider, run_id=None, **engine_options):
        self.surface = surface
        self.provider = configuration_provider
        self.run_id = run_id or uuid4().hex
        self.nine = NineViewEngine(surface.segmenter, **engine_options)
        self.routes = {}
        self.neighbours = []
        self.timestamp, self.captured_at, self.fps = 0., time.monotonic(), 30.
        self.frame_times, self.frame_ages = deque(maxlen=10000), deque(maxlen=10000)
        self.counters = Counter()
        self.start = time.monotonic()
        self._original_record = surface.record_tracked_detection
        self._original_capture = surface.add_tracked_detection
        surface.record_tracked_detection = self._record
        surface.add_tracked_detection = self._capture
        surface.detector = ObservedDetector(surface.detector, self)

    def __getattr__(self, name):
        return getattr(self.surface, name)

    @property
    def tracking_metrics(self):
        return self.surface.tracking_metrics

    @tracking_metrics.setter
    def tracking_metrics(self, value):
        self.surface.tracking_metrics = value

    def set_frame_rate(self, fps):
        if fps and fps > 0:
            self.fps = float(fps)
        self.surface.set_frame_rate(fps)

    def _record(self, frame, track_id, box, index):
        route = self.routes.get(track_id)
        if route is not None and route['published']:
            self.last_seen_frame[track_id] = index
            # The shared tracking loop annotates the current observation after
            # this hook returns. Keep one lightweight row for that annotation.
            x0, y0, x1, y1 = map(float, box)
            h, w = frame.shape[:2]
            self.tracking_history_by_id[track_id] = [dict(frame=index,
                bbox_xyxy=[x0, y0, x1, y1], touches_frame_edge=x0 <= 2 or y0 <= 2 or x1 >= w - 2 or y1 >= h - 2)]
            return
        self._original_record(frame, track_id, box, index)
        route = self.routes.get(track_id)
        if route is None:
            snapshot = self.provider()
            progress, across = progress_at(box, frame.shape, snapshot.nine_view)
            if progress is not None and (not across or progress < 0 or progress >= 1):
                history = self.tracking_history_by_id[track_id]
                if len(history) > 128:
                    self.tracking_history_by_id[track_id] = history[:1] + history[-127:]
                return
            route = dict(snapshot=snapshot, key=f'{self.run_id}:{track_id}',
                         surface_settings=replace(self.surface.settings), published=False, last_frame=-1)
            self.routes[track_id] = route
            self.counters['entered_fruit'] += 1
            if snapshot.algorithm == 'nine_view':
                if not self.nine.open(route['key'], track_id, snapshot, self.timestamp, self.captured_at):
                    route['overloaded'] = True
                    self.nine.counts['active_overloads'] += 1
        if route['published'] or route['last_frame'] == index:
            return
        route['last_frame'] = index
        if route['snapshot'].algorithm == 'nine_view' and not route.get('overloaded'):
            history = self.tracking_history_by_id[track_id]
            if len(history) > 128:
                self.tracking_history_by_id[track_id] = history[:1] + history[-127:]
            uncertain = self.identity_guard.metadata.get(track_id, {}).get('identity_status') == 'uncertain'
            self.nine.observe(route['key'], frame, box, index, self.timestamp, self.captured_at,
                              self.neighbours, uncertain)

    def _capture(self, frame, track_id, box, index):
        route = self.routes.get(track_id)
        if route is None or route['published']:
            return False
        if route['snapshot'].algorithm == 'nine_view':
            return False  # Selection already ran from every tracking observation.
        return self._original_capture(frame, track_id, box, index)

    def process_frame(self, frame, frame_index, capture_views=True, timestamp=None, capture_monotonic=None):
        started = time.perf_counter()
        self.timestamp = float(timestamp) if timestamp is not None else frame_index / self.fps
        self.captured_at = time.monotonic() if capture_monotonic is None else capture_monotonic
        kwargs = dict(capture_views=capture_views, timestamp=self.timestamp)
        if getattr(self.surface, 'inspection_profile', None) == 'realtime':
            kwargs['capture_monotonic'] = self.captured_at
        result = self.surface.process_frame(frame, frame_index, **kwargs)
        self.nine.expire()
        self.frame_times.append(time.perf_counter() - started)
        self.frame_ages.append(max(0., time.monotonic() - self.captured_at))
        self.counters['processed_frames'] += 1
        return result

    def ready_tracks(self):
        self.nine.expire()
        with self.nine.condition:
            return [track_id for track_id, route in self.routes.items() if not route['published'] and
                    route['snapshot'].algorithm == 'nine_view' and
                    (route.get('overloaded') or (self.nine.fruit.get(route['key']) is not None and
                                               self.nine.fruit[route['key']].result is not None))]

    def end_track(self, track_id, reason='track_loss'):
        route = self.routes.get(track_id)
        if route is None or route['published']:
            return
        if route['snapshot'].algorithm == 'nine_view':
            self.nine.end(route['key'], reason)
        elif hasattr(self.surface, 'end_track'):
            self.surface.end_track(track_id)

    def track_ready(self, track_id):
        route = self.routes.get(track_id)
        if route is None or route['published']:
            return False
        if route['snapshot'].algorithm == 'nine_view':
            return route.get('overloaded', False) or self.nine.ready(route['key'])
        return self.surface.track_ready(track_id) if hasattr(self.surface, 'track_ready') else True

    def already_published(self, track_id):
        return self.routes.get(track_id, {}).get('published', False)

    def detach_track(self, track_id):
        route = self.routes[track_id]
        if route['published'] or not self.track_ready(track_id):
            raise RuntimeError('Track cannot be published twice or before its evidence drains')
        snapshot = route['snapshot']
        identity = dict(self.identity_guard.metadata.get(track_id, {}))
        history = list(self.tracking_history_by_id.get(track_id, []))
        images = dict(self.tracking_images_by_id.get(track_id, {}))
        if snapshot.algorithm == 'nine_view':
            if route.get('overloaded'):
                result, views = dict(track_id=track_id, fruit_uid=route['key'], algorithm='nine_view',
                    configuration_version=snapshot.version, configuration_snapshot=asdict(snapshot),
                    status='nine_view_overloaded', reason='Active-fruit buffer is full', grade=None,
                    grade_provisional=False, evidence_complete=False, selected_crops=0,
                    processed_crops=0, required_crops=9, views=0, view_frames=[],
                    calibration_status=snapshot.nine_view.calibration_status,
                    calibration_id=snapshot.nine_view.calibration_id, whole_surface_coverage_known=False), []
            else:
                result, views = self.nine.detach(route['key'])
                views = [replace(view, mask=None if view.mask is None else view.mask.copy(),
                         defect_masks={name: mask.copy() for name, mask in view.defect_masks.items()})
                         for view in views]
            result.update(identity)
            if identity.get('identity_status') == 'uncertain':
                result.update(status='identity_uncertain', grade=None, grade_provisional=False,
                              reason='Uncertain physical-fruit association; grading withheld')
            frozen = SimpleNamespace(nine_view_result=result, nine_view_images=views,
                contact_sheet=snapshot.nine_view.contact_sheet,
                tracking_history_by_id={track_id: history}, tracking_images_by_id={track_id: images})
        elif hasattr(self.surface, 'detach_track'):
            try:
                mapped, failure = self.surface.finish_track(track_id), None
            except MappingError as error:
                mapped, failure = None, error
            frozen = SimpleNamespace(settings=route['surface_settings'],
                views_by_id={track_id: list(self.views_by_id.get(track_id, []))},
                rejected_views_by_id={track_id: dict(self.rejected_views_by_id.get(track_id, {}))},
                tracking_history_by_id={track_id: history}, tracking_images_by_id={track_id: images},
                identity_guard=SimpleNamespace(metadata={track_id: identity}))
            def finish(_track_id):
                if failure is not None:
                    raise failure
                return mapped
            frozen.finish_track = finish
            self.surface.online.pop(track_id, None)
        else:
            # Only the finished fruit's immutable evidence is used on the export
            # worker. Shared model calls still pass through the bounded scheduler.
            frozen = NaartjiePipeline(self.segmenter, settings=route['surface_settings'],
                defer_defect_segmentation=self.defer_defect_segmentation)
            frozen.views_by_id[track_id] = list(self.views_by_id.get(track_id, []))
            frozen.rejected_views_by_id[track_id] = dict(self.rejected_views_by_id.get(track_id, {}))
            frozen.tracking_history_by_id[track_id] = history
            frozen.tracking_images_by_id[track_id] = images
            frozen.identity_guard.metadata[track_id] = identity
        frozen.algorithm_assignment = dict(algorithm=snapshot.algorithm, fruit_uid=route['key'],
            configuration_version=snapshot.version, configuration_snapshot=asdict(snapshot),
            surface_mapping_settings=asdict(route['surface_settings']))
        if not hasattr(frozen, 'drop_track'):
            frozen.drop_track = lambda _track_id: None
        route['published'] = True
        # Preserve the guard's association until actual track loss. A timed-out
        # stationary fruit must not get a new ID/result on its next observation.
        self.views_by_id.pop(track_id, None)
        self.tracking_history_by_id.pop(track_id, None)
        self.tracking_images_by_id.pop(track_id, None)
        self.counters['published_fruit'] += 1
        return frozen

    def drop_track(self, track_id):
        # _finish_track operates on a detached object; live tombstones disappear
        # only when the tracker has actually lost that fruit.
        route = self.routes.pop(track_id, None)
        if route:
            with self.nine.condition:
                self.nine.fruit.pop(route['key'], None)
        self.surface.drop_track(track_id)

    def flush(self):
        for track_id in list(self.routes):
            self.end_track(track_id, 'end_of_stream')
        if hasattr(self.surface, 'flush'):
            self.surface.flush()
        # Deadline bounds the drain; the dispatcher continues processing crops.
        while any(not self.track_ready(i) and not r['published'] for i, r in self.routes.items()):
            with self.nine.condition:
                self.nine.condition.wait(timeout=.025)
            self.nine.expire()

    def runtime_metrics(self):
        elapsed = max(.000001, time.monotonic() - self.start)
        return dict(profile='mixed_strategies', model_input_size=[640, 640],
            counters=dict(self.counters), nine_view=self.nine.metrics(),
            processing_fps=len(self.frame_times) / sum(self.frame_times) if self.frame_times else 0.,
            frame_age_p50_ms=float(np.percentile(self.frame_ages, 50) * 1000) if self.frame_ages else None,
            frame_age_p95_ms=float(np.percentile(self.frame_ages, 95) * 1000) if self.frame_ages else None,
            fruit_arrivals_per_second=self.counters['entered_fruit'] / elapsed,
            published_fruit_per_second=self.counters['published_fruit'] / elapsed)

    def close(self):
        self.nine.close()
        if hasattr(self.surface, 'close'):
            self.surface.close()
        else:
            scheduler = getattr(self.segmenter, 'scheduler', None)
            if scheduler:
                scheduler.close()
        for track_id in list(self.last_seen_frame):
            self.drop_track(track_id)

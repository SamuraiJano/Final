.app-shell { min-height: 100vh; display: grid; grid-template-columns: 222px minmax(0, 1fr); background: #081b18; }
.sidebar { position: sticky; top: 0; height: 100vh; background: #061714; border-right: 1px solid #244039; padding: 29px 18px 22px; display: flex; flex-direction: column; }
.brand { display: flex; align-items: center; gap: 11px; text-decoration: none; color: #f3fff6; padding: 3px 7px; }
.brand-mark { width: 31px; height: 31px; border: 2px solid #aff49d; border-radius: 50%; display: grid; place-items: center; transform: rotate(-24deg); box-shadow: 0 0 22px #b6f59b35; }
.brand-mark span { width: 12px; height: 12px; border: 2px solid #aff49d; border-radius: 50%; position: relative; }
.brand-mark span::after { content: ''; position: absolute; width: 5px; height: 6px; border-radius: 8px 0; background: #aff49d; top: -8px; left: 8px; }
.brand strong { display: block; font-size: 17px; letter-spacing: -.5px; font-weight: 700; line-height: 1; }
.brand strong span { color: #a8e996; }
.brand small { display: block; font-size: 8px; letter-spacing: 1.6px; color: #88aaa0; margin-top: 6px; font-weight: 700; }
.side-nav-label { margin: 60px 14px 14px; color: #5f8176; font-size: 10px; letter-spacing: 1.8px; font-weight: 750; }
.side-nav { display: grid; gap: 6px; }
.side-nav a { display: flex; align-items: center; gap: 13px; padding: 13px 14px; color: #8faea2; text-decoration: none; border-radius: 10px; font-size: 13px; font-weight: 650; transition: background .2s, color .2s; }
.side-nav a:hover { color: #ebfaee; background: #112e27; }
.side-nav a.active { color: #122418; background: #b5f37e; box-shadow: 0 7px 24px #aaf48820; }
.sidebar-bottom { margin-top: auto; display: flex; gap: 10px; align-items: flex-start; border: 1px solid #26453c; background: #10271f; border-radius: 12px; padding: 15px 11px; }
.system-dot, .live-dot { flex: none; display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: #b18b4e; box-shadow: 0 0 0 4px #b18b4e20; margin-top: 3px; }
.system-dot.online, .live-dot.on { background: #92e899; box-shadow: 0 0 0 4px #92e89920; }
.sidebar-bottom strong { display: block; font-size: 12px; color: #e6f7e9; }
.sidebar-bottom span { display: block; font-size: 10px; line-height: 1.5; color: #8aa99b; margin-top: 3px; }
.workspace { min-width: 0; width: 100%; max-width: 1560px; padding: 0 38px 26px; margin: 0 auto; }
.topbar { height: 67px; border-bottom: 1px solid #254039; display: flex; justify-content: space-between; align-items: center; gap: 16px; }
.breadcrumbs { color: #78a092; font-size: 10px; font-weight: 800; letter-spacing: 1.6px; }
.breadcrumbs span { margin: 0 12px; color: #486b5b; }
.top-status { display: inline-flex; align-items: center; gap: 9px; color: #a6c3b4; font-size: 11px; font-weight: 650; white-space: nowrap; }
.top-status .live-dot { margin: 0; }
.top-status-divider { height: 17px; width: 1px; background: #315146; margin: 0 7px; }
.page-heading { display: flex; align-items: flex-end; justify-content: space-between; gap: 20px; padding: 30px 0 25px; }
.eyebrow { display: block; color: #88b59d; font-size: 10px; font-weight: 800; letter-spacing: 1.7px; line-height: 1.4; }
.page-heading h1 { font-size: clamp(30px, 3vw, 42px); line-height: 1.06; margin: 9px 0 7px; letter-spacing: -1.7px; font-weight: 700; color: #f0f8ef; }
.heading-period { color: #b6ef82; }
.page-heading p { color: #8dac9f; margin: 0; font-size: 13px; }
.last-analysis { text-align: right; padding-bottom: 2px; }
.last-analysis span { display: block; color: #648b79; font-size: 9px; font-weight: 800; letter-spacing: 1.5px; margin-bottom: 8px; }
.last-analysis strong { display: block; color: #c7dcd0; font-size: 12px; font-weight: 650; }
.history-scope-row { display: flex; align-items: center; flex-wrap: wrap; gap: 10px 18px; margin: -10px 0 18px; }
.history-scope { border: 1px solid #385747; border-radius: 9px; padding: 3px; background: #102721; flex: none; }
.history-scope-row p { margin: 0; color: #8dac9f; font-size: 11px; overflow-wrap: anywhere; }
.summary-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; margin-bottom: 16px; }
.metric-card, .panel { border: 1px solid #2b4b3f; background: #102721; border-radius: 13px; box-shadow: 0 12px 34px #00130c25; }
.metric-card { padding: 17px 20px 18px; min-height: 123px; position: relative; overflow: hidden; }
.metric-card.accent { background: linear-gradient(115deg, #163d2d, #123324 65%, #15352b); border-color: #3e7952; }
.metric-card.accent::after { content: ''; position: absolute; width: 110px; height: 110px; right: -42px; bottom: -54px; border: 21px solid #a3ec8955; border-radius: 50%; }
.metric-card-top { display: flex; align-items: center; justify-content: space-between; color: #a6c2b0; font-size: 12px; font-weight: 700; }
.metric-icon { width: 30px; height: 30px; display: grid; place-items: center; border-radius: 9px; background: #264438; color: #a4e79c; }
.metric-card.accent .metric-icon { background: #b6f384; color: #143c2a; }
.metric-value { font-size: 31px; font-weight: 750; letter-spacing: -1.2px; line-height: 1.1; color: #effaf0; margin-top: 8px; }
.metric-hint { color: #8dab9e; font-size: 11px; margin-top: 6px; }
.monitor-grid { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(345px, .88fr); gap: 16px; align-items: stretch; }
.camera-panel { padding: 18px; display: flex; flex-direction: column; min-width: 0; }
.panel-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; }
.panel-heading h2 { color: #edf8ee; font-size: 18px; letter-spacing: -.45px; margin: 4px 0 0; line-height: 1.25; }
.panel-caption { font-size: 9px; font-weight: 750; color: #729b87; letter-spacing: 1.3px; margin-top: 8px; white-space: nowrap; }
.feed-badge { display: inline-flex; align-items: center; gap: 7px; color: #b6c7b8; font-size: 9px; letter-spacing: 1px; font-weight: 800; border: 1px solid #385747; border-radius: 6px; padding: 7px 9px; background: #193328; white-space: nowrap; }
.feed-badge > span { width: 6px; height: 6px; border-radius: 50%; background: #c99b58; }
.feed-badge.connected > span { background: #a8f288; }
.camera-stage { margin-top: 16px; background: radial-gradient(circle at 50% 38%, #193c32, #071a17 58%); border: 1px solid #2a5443; border-radius: 9px; min-height: 220px; aspect-ratio: 16 / 8.7; position: relative; overflow: hidden; display: grid; place-items: center; }
.camera-stage::before { content: ''; position: absolute; inset: 0; pointer-events: none; background: linear-gradient(0deg, #a8e7ac0a 1px, transparent 1px); background-size: 100% 7px; opacity: .45; z-index: 1; }
.camera-stage video, .camera-stage > img { display: block; width: 100%; height: 100%; object-fit: contain; position: absolute; inset: 0; background: #071714; }
.camera-empty, .camera-overlay { position: relative; z-index: 2; display: flex; flex-direction: column; align-items: center; text-align: center; padding: 20px; color: #9bbba9; }
.camera-overlay { position: absolute; inset: 0; justify-content: center; background: #071b19e8; }
.camera-empty-icon { height: 68px; width: 68px; display: grid; place-items: center; margin-bottom: 14px; border-radius: 20px; border: 1px solid #42644e; background: #204431; color: #b0ed9c; box-shadow: 0 0 0 13px #1d433625; }
.camera-empty strong, .camera-overlay strong { color: #e8f5e6; font-size: 15px; margin-bottom: 7px; }
.camera-empty > span, .camera-overlay > span { max-width: 250px; color: #84a594; font-size: 11px; line-height: 1.5; }
.camera-overlay > svg { color: #b4ef9a; margin-bottom: 12px; }
.camera-corner { position: absolute; z-index: 3; width: 20px; height: 20px; border-color: #aeed9b; opacity: .65; pointer-events: none; }
.camera-corner.top-left { top: 13px; left: 13px; border-top: 2px solid; border-left: 2px solid; }
.camera-corner.top-right { top: 13px; right: 13px; border-top: 2px solid; border-right: 2px solid; }
.camera-corner.bottom-left { bottom: 13px; left: 13px; border-bottom: 2px solid; border-left: 2px solid; }
.camera-corner.bottom-right { bottom: 13px; right: 13px; border-bottom: 2px solid; border-right: 2px solid; }
.camera-controls { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-top: 16px; }
.source-caption { min-width: 0; }
.source-label { display: block; font-size: 9px; color: #719887; font-weight: 750; letter-spacing: 1.25px; margin-bottom: 4px; }
.source-caption strong { display: block; font-size: 11px; color: #d7ebd8; font-weight: 650; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; max-width: 235px; }
.camera-actions { display: flex; align-items: center; gap: 8px; flex: none; }
.secondary-button, .primary-button, .refresh-button, .stop-button, .text-button, .icon-button { cursor: pointer; font: inherit; }
.secondary-button, .primary-button, .refresh-button, .stop-button { display: inline-flex; align-items: center; gap: 7px; height: 35px; border-radius: 8px; padding: 0 12px; font-size: 11px; font-weight: 750; white-space: nowrap; }
.secondary-button { border: 1px solid #456a52; background: #19372b; color: #dcf0dc; }
.secondary-button:hover { background: #254535; }
.refresh-button { border: 1px solid #456a52; background: #143128; color: #c7e7d0; }
.refresh-button:hover { background: #254535; }
.refresh-button:disabled { opacity: .5; cursor: not-allowed; }
.stop-button { border: 1px solid #a86a59; background: #4b302b; color: #ffd4c4; }
.stop-button:hover { background: #643b32; }
.stop-button:disabled { opacity: .5; cursor: not-allowed; }
.live-button { display: inline-flex; align-items: center; gap: 7px; height: 35px; padding: 0 12px; border: 1px solid #559462; border-radius: 8px; background: #244d32; color: #d8f5d1; font: inherit; font-size: 11px; font-weight: 750; white-space: nowrap; cursor: pointer; }
.live-button:hover { background: #326940; }
.live-button.running { border-color: #805540; background: #4a342b; color: #f2c2a2; }
.live-button.running:hover { background: #654333; }
.live-button:disabled, .secondary-button.disabled { opacity: .5; cursor: not-allowed; }
.primary-button { border: 1px solid #b7f189; background: #b7f189; color: #15351e; }
.primary-button:hover { background: #cefca7; }
.primary-button:disabled { opacity: .43; cursor: not-allowed; }
.text-button { color: #9bce9b; background: none; border: 0; font-size: 11px; font-weight: 700; padding: 7px 5px; }
.upload-error { display: flex; align-items: flex-start; gap: 7px; margin: 13px 0 0; color: #ffb9a9; font-size: 11px; line-height: 1.5; }
.refresh-message { margin: 13px 0 0; color: #b8edaa; font-size: 11px; }
.analysis-status-row { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; padding-top: 13px; }
.analysis-status-row .analysis-progress { padding-top: 0; }
.analysis-status-row .stop-button { margin-left: auto; }
.analysis-progress { display: flex; align-items: center; gap: 9px; color: #bbdfbc; font-size: 11px; padding-top: 13px; }
.analysis-progress > span { width: 10px; height: 10px; border: 2px solid #baf399; border-top-color: transparent; border-radius: 50%; animation: spin .9s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }
.monitor-side { min-width: 0; display: grid; grid-template-rows: auto 1fr; gap: 16px; }
.quality-panel, .performance-panel { padding: 18px; }
.quality-total { display: flex; align-items: baseline; gap: 9px; margin-top: 17px; }
.quality-total strong { font-size: 29px; letter-spacing: -1px; line-height: 1; color: #f0fbef; }
.quality-total span { color: #89ab96; font-size: 11px; }
.mix-bar { display: flex; height: 9px; width: 100%; margin-top: 14px; background: #284136; border-radius: 999px; overflow: hidden; }
.mix-bar > span { height: 100%; }
.mix-class-1 { background: #b8f489; }
.mix-class-2 { background: #72ca99; }
.mix-class-3 { background: #478b77; }
.mix-ungraded { background: #bc9067; }
.mix-legend { display: grid; grid-template-columns: 1fr 1fr; column-gap: 17px; row-gap: 9px; margin-top: 15px; }
.mix-legend > div { display: flex; align-items: center; gap: 7px; font-size: 11px; color: #a6c2ae; }
.mix-legend strong { margin-left: auto; font-weight: 750; color: #e4f2e6; }
.legend-dot { width: 7px; height: 7px; border-radius: 50%; }
.performance-panel { display: flex; flex-direction: column; }
.model-row { border-top: 1px solid #2b483b; padding-top: 13px; margin-top: 13px; }
.model-row-head { display: flex; align-items: center; gap: 9px; }
.model-mark { display: grid; place-items: center; width: 31px; height: 31px; border-radius: 9px; flex: none; }
.model-mark.detect { background: #1d4933; color: #b4ed98; }
.model-mark.segment { background: #23443d; color: #8bdcc1; }
.model-row-head > div { min-width: 0; }
.model-row-head strong { display: block; font-size: 11px; color: #ecf9ed; }
.model-row-head small { display: block; color: #769b86; font-size: 9px; margin-top: 3px; }
.model-latency { margin-left: auto; color: #c0e4ba; font-size: 12px; font-weight: 750; white-space: nowrap; }
.confidence-line { display: flex; justify-content: space-between; color: #8fb29c; font-size: 10px; margin-top: 11px; }
.confidence-line strong { color: #d7efcf; }
.confidence-track { height: 5px; border-radius: 99px; background: #28473b; overflow: hidden; margin-top: 6px; }
.confidence-track span { display: block; height: 100%; border-radius: inherit; background: linear-gradient(90deg, #509d70, #bbf18e); }
.model-note { display: block; color: #709582; font-size: 9px; margin-top: 7px; }
.confidence-disclaimer { color: #7fa28e; font-size: 9px; margin: auto 0 0; padding-top: 11px; }
.inspections-section { margin-top: 29px; scroll-margin-top: 18px; }
.section-heading { display: flex; align-items: end; justify-content: space-between; gap: 15px; margin-bottom: 15px; }
.section-heading h2 { color: #eef8ed; font-size: 21px; letter-spacing: -.65px; margin: 5px 0 0; }
.section-heading h2 span { font-weight: 450; color: #8eaf9d; }
.section-count { color: #7fa38f; font-size: 10px; white-space: nowrap; }
.inspection-panel { overflow: hidden; }
.inspection-toolbar { display: flex; justify-content: space-between; gap: 16px; padding: 16px 18px; align-items: center; }
.filter-tabs { display: flex; gap: 4px; min-width: 0; overflow-x: auto; scrollbar-width: thin; }
.filter-tabs button { border: 0; background: transparent; color: #8fb09d; font: inherit; font-size: 11px; font-weight: 700; padding: 8px 10px; border-radius: 7px; cursor: pointer; white-space: nowrap; }
.filter-tabs button:hover { color: #ebf8ea; background: #294b38; }
.filter-tabs button.selected { color: #173520; background: #b6ef86; }
.search-box { flex: 0 1 210px; display: flex; align-items: center; gap: 7px; height: 34px; border: 1px solid #3d5d4d; border-radius: 8px; color: #83a98e; background: #0b211b; padding: 0 9px; }
.search-box:focus-within { border-color: #a5e69b; }
.search-box input { width: 100%; min-width: 0; color: #e7f7e6; background: transparent; outline: none; border: 0; font: inherit; font-size: 11px; }
.search-box input::placeholder { color: #638572; }
.table-head, .fruit-row { display: grid; grid-template-columns: minmax(220px, 2.1fr) minmax(120px, 1fr) minmax(80px, .75fr) minmax(80px, .75fr) minmax(90px, .8fr) 20px; gap: 12px; align-items: center; }
.table-head { padding: 11px 18px; background: #0d231c; color: #6f9680; font-size: 9px; letter-spacing: 1.1px; font-weight: 800; border-top: 1px solid #2b493b; border-bottom: 1px solid #2b493b; }
.fruit-row { width: 100%; border: 0; border-bottom: 1px solid #284538; padding: 11px 18px; text-align: left; color: #d7e8da; background: transparent; cursor: pointer; font: inherit; transition: background .2s; }
.fruit-row:hover { background: #19392a; }
.fruit-row:last-child { border-bottom: 0; }
.fruit-identity { min-width: 0; display: flex; align-items: center; gap: 10px; }
.fruit-avatar { width: 38px; height: 38px; display: grid; place-items: center; flex: none; border: 1px solid #416342; background: #21432d; color: #b1dcaa; border-radius: 8px; overflow: hidden; }
.fruit-avatar img { width: 100%; height: 100%; object-fit: cover; }
.fruit-identity > span:last-child { min-width: 0; }
.fruit-identity strong { color: #eef9ec; font-size: 11px; font-weight: 750; display: block; }
.fruit-identity small { color: #7a9a86; font-size: 9px; display: block; margin-top: 5px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.grade-pill { display: inline-flex; align-items: center; border-radius: 5px; padding: 6px 8px; line-height: 1; font-size: 10px; font-weight: 750; white-space: nowrap; }
.grade-1 { background: #b7ef8e20; color: #c5f49f; }
.grade-2 { background: #6bd6a01d; color: #88dfab; }
.grade-3 { background: #cf986b1c; color: #ecc098; }
.grade-review { background: #ae8e6b21; color: #dcc4a6; }
.table-number { color: #bed2c2; font-size: 11px; font-variant-numeric: tabular-nums; }
.map-cell { color: #b5eb9d; font-size: 11px; font-weight: 700; }
.fruit-row > svg { color: #7ba890; }
.inspection-empty { min-height: 178px; display: flex; flex-direction: column; justify-content: center; align-items: center; gap: 7px; text-align: center; padding: 26px; }
.empty-symbol { display: grid; place-items: center; width: 44px; height: 44px; background: #1b3d2c; border-radius: 12px; color: #b5e9a6; margin-bottom: 5px; }
.inspection-empty strong { color: #d9ecdc; font-size: 12px; }
.inspection-empty > span:last-child { color: #7f9e8a; font-size: 11px; }
.table-footer { border-top: 1px solid #2b493b; text-align: center; padding: 12px; }
.table-footer button { background: transparent; border: 0; color: #bcf3a3; display: inline-flex; align-items: center; gap: 8px; font: inherit; font-size: 11px; cursor: pointer; }
.app-footer { display: flex; justify-content: space-between; gap: 14px; color: #688b78; font-size: 10px; padding-top: 21px; }
.drawer-backdrop { position: fixed; inset: 0; background: #02100bcc; z-index: 10; display: flex; justify-content: flex-end; }
.detail-drawer { width: min(100%, 475px); min-height: 100%; max-height: 100vh; overflow-y: auto; padding: 30px; background: #102920; border-left: 1px solid #507355; box-shadow: -30px 0 80px #0006; }
.drawer-top { display: flex; justify-content: space-between; align-items: start; margin-bottom: 17px; }
.drawer-top h2 { font-size: 25px; letter-spacing: -.7px; margin: 5px 0 0; }
.icon-button { display: grid; place-items: center; width: 34px; height: 34px; color: #bdd6be; background: #21402e; border: 1px solid #3d6046; border-radius: 8px; }
.drawer-subtitle { color: #8daa9a; font-size: 11px; margin: 13px 0 19px; }
.detail-map { background: #081a16; border: 1px solid #32513b; border-radius: 11px; overflow: hidden; min-height: 220px; display: grid; place-items: center; }
.detail-map img { display: block; width: 100%; max-height: 330px; object-fit: contain; }
.map-unavailable { display: flex; align-items: center; flex-direction: column; gap: 9px; color: #93af9b; font-size: 12px; }
.detail-stats { display: grid; grid-template-columns: 1fr 1fr; gap: 1px; background: #34543f; border: 1px solid #34543f; border-radius: 9px; overflow: hidden; margin-top: 18px; }
.detail-stats > div { background: #173326; padding: 14px; }
.detail-stats span { display: block; color: #89a990; font-size: 10px; margin-bottom: 7px; }
.detail-stats strong { color: #eef9ec; font-size: 17px; }
.review-reason { display: flex; gap: 9px; color: #e4c3a2; font-size: 11px; line-height: 1.5; background: #4a352b5e; border: 1px solid #76533a; border-radius: 8px; padding: 12px; margin-top: 17px; }
.review-reason svg { flex: none; }
.map-details { border-top: 1px solid #345741; margin-top: 22px; padding-top: 17px; }
.map-details summary { cursor: pointer; color: #d3ebd2; font-weight: 700; font-size: 12px; }
.mask-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 15px; }
.mask-grid > div { min-width: 0; }
.evidence-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; }
.evidence-view { margin-top: 18px; }
.evidence-view > strong { font-size: 12px; color: #d3ebd2; }
.evidence-note { color: #9dbba8; font-size: 11px; line-height: 1.6; margin: 10px 0 0; }
.mask-grid span { display: block; color: #89ad96; font-size: 10px; margin-bottom: 5px; }
.mask-grid img { display: block; width: 100%; background: #071914; border-radius: 7px; border: 1px solid #31523d; }
.report-link { display: inline-flex; align-items: center; gap: 8px; color: #b7ee9f; text-decoration: none; font-size: 12px; font-weight: 700; margin-top: 23px; }
.report-link:hover { text-decoration: underline; }
.sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
button:focus-visible, a:focus-visible, summary:focus-visible, label:focus-within { outline: 2px solid #b7f28d; outline-offset: 2px; }

@media (max-width: 1200px) {
  .workspace { padding-left: 25px; padding-right: 25px; }
  .monitor-grid { grid-template-columns: minmax(0, 1.35fr) minmax(320px, .9fr); }
  .camera-controls { align-items: stretch; flex-direction: column; }
  .camera-actions { justify-content: flex-end; flex-wrap: wrap; }
}

@media (max-width: 1050px) {
  .monitor-grid { grid-template-columns: 1fr; }
  .monitor-side { grid-template-columns: 1fr 1fr; grid-template-rows: 1fr; }
  .camera-stage { aspect-ratio: 16 / 8; }
  .camera-controls { flex-direction: row; align-items: center; }
}

@media (max-width: 800px) {
  .app-shell { display: block; }
  .sidebar { position: static; height: auto; padding: 15px 18px; flex-direction: row; align-items: center; justify-content: space-between; border-right: 0; border-bottom: 1px solid #294b3a; }
  .side-nav-label, .sidebar-bottom { display: none; }
  .side-nav { display: flex; }
  .side-nav a { padding: 9px; font-size: 0; gap: 0; }
  .side-nav a svg { width: 18px; height: 18px; }
  .workspace { padding: 0 18px 24px; }
  .topbar { height: 48px; }
  .page-heading { padding-top: 24px; }
  .summary-grid { gap: 9px; }
  .metric-card { padding: 14px; }
  .metric-value { font-size: 26px; }
  .table-head, .fruit-row { grid-template-columns: minmax(180px, 2fr) minmax(110px, 1fr) minmax(70px, .7fr) 18px; }
  .table-head span:nth-child(4), .table-head span:nth-child(5), .fruit-row > span:nth-child(4), .fruit-row > span:nth-child(5) { display: none; }
}

@media (max-width: 620px) {
  .topbar { display: none; }
  .last-analysis { display: none; }
  .page-heading h1 { font-size: 31px; }
  .summary-grid { grid-template-columns: 1fr 1fr; }
  .summary-grid > :last-child { grid-column: 1 / -1; }
  .metric-card { min-height: 112px; }
  .metric-card-top { font-size: 11px; }
  .monitor-side { grid-template-columns: 1fr; }
  .camera-panel, .quality-panel, .performance-panel { padding: 15px; }
  .camera-stage { min-height: 210px; aspect-ratio: 4 / 3; }
  .camera-controls { flex-direction: column; align-items: stretch; }
  .camera-actions { justify-content: space-between; }
  .source-caption strong { max-width: 100%; }
  .inspection-toolbar { flex-direction: column-reverse; align-items: stretch; padding: 13px; }
  .search-box { flex-basis: auto; }
  .filter-tabs { width: 100%; }
  .table-head { display: none; }
  .fruit-row { grid-template-columns: minmax(0, 1fr) auto 18px; gap: 8px; padding: 12px; }
  .fruit-row > span:nth-child(3) { display: none; }
  .fruit-identity small { max-width: 170px; }
  .section-heading h2 { font-size: 18px; }
  .section-count { display: none; }
  .app-footer span:last-child { display: none; }
  .detail-drawer { padding: 20px; }
}
